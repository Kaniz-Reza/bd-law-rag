{
  "uid": "bd-law-rag",
  "title": "bd-law-rag monitoring",
  "tags": ["bd-law-rag"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Requests by outcome (total)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (outcome) (ask_requests_total)", "legendFormat": "{{outcome}}", "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name"}, "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}, "overrides": []}},
    {"id": 2, "type": "stat", "title": "Answers by Gemini model (total)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (model) (llm_model_used_total)", "legendFormat": "{{model}}", "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name"}, "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Requests per minute, by outcome", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (outcome) (increase(ask_requests_total[1m]))", "legendFormat": "{{outcome}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 4, "type": "timeseries", "title": "Request latency (p50 / p95)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(ask_latency_seconds_bucket[2m])))", "legendFormat": "p50", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(ask_latency_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 5, "type": "timeseries", "title": "Average time: retrieval vs Gemini", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(retrieval_latency_seconds_sum[2m]) / rate(retrieval_latency_seconds_count[2m])", "legendFormat": "retrieval", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(llm_latency_seconds_sum[2m]) / rate(llm_latency_seconds_count[2m])", "legendFormat": "gemini", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Answers per minute, by Gemini model", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (model) (increase(llm_model_used_total[1m]))", "legendFormat": "{{model}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ]
}
